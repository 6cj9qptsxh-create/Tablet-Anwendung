APP_NAME="Haus Meli"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.10:8081

# Gleicher Origin wie APP_URL (QR + Teilen). Anpassen, wenn der Virtual Host anders lautet.
SHARE_PUBLIC_ORIGIN=http://192.168.1.10:8081

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ferienwohnung_laravel
DB_USERNAME=Lukas
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Synology Web Station sitzt oft vor PHP — sonst ist request()->ip() immer 127.0.0.1
TRUSTED_PROXIES=*

# Familie vs Gast (Gast-WLAN muss die NAS erreichen)
OWNER_IP_PREFIX=192.168.1.,100.

# E-Paper E1001 Agenda-Feed (Home Assistant)
E1001_AGENDA_TOKEN=
GUEST_IP_PREFIX=192.168.20.

# meteoblue. Schlüssel nur hier, nicht ins Tablet. Ort aktuell Lauterach.
METEOBLUE_API_KEY=
WEATHER_PLACE=Lauterach
WEATHER_LAT=47.477
WEATHER_LON=9.729
WEATHER_ASL=412
WEATHER_TZ=Europe/Vienna

TOURS_ADMIN_PASSWORD=meli-tours

# Linux-Pfad auf der NAS (nicht \\NAS\...)
ORDER_PDF_ROOT=/volume1/web/ferienwohnung/bestellungen
ORDER_PDF_ADDRESS="Straße Nr, PLZ Ort"
ORDER_PDF_NAME_GUEST=Ferienwohnung
ORDER_PDF_NAME_OWNER="Fam. Jörg"

TOURS_MEDIA_URL=
